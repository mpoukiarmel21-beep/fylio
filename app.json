{
  "expo": {
    "name": "Fylio",
    "slug": "fylio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1F8FE"
    },
    "ios": {
      "bundleIdentifier": "com.fylio.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Fylio accède à vos photos pour les transférer et les afficher dans la galerie.",
        "NSPhotoLibraryAddUsageDescription": "Fylio enregistre les fichiers reçus dans votre galerie.",
        "NSLocalNetworkUsageDescription": "Fylio découvre les appareils sur votre réseau Wi-Fi pour transférer des fichiers.",
        "NSBonjourServices": [
          "_fylio._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "fylio"
  }
}